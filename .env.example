# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection used by the app (the only data path in the MVP).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Local:    `pnpm db:local` prints postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Supabase project details. Reserved for future Supabase features (storage/realtime);
# not required by the MVP code path, but documented for deployment completeness.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── LLM providers (server-side only; never exposed to the browser) ─────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Authentication (single operator) ────────────────────────────────────────
APP_USERNAME=operator
# bcrypt hash — generate with `pnpm hash-password '<password>'`.
# In .env.local files every `$` must be escaped as `\$` (the script prints this form).
# In the Vercel dashboard paste the raw hash.
APP_PASSWORD_HASH=
# At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=

# ─── Scheduling ──────────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/research.
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Contact address sent to Europe PMC / Crossref (polite API use).
CONTACT_EMAIL=
